POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=payodi
MINIO_ROOT_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://payodi:CHANGE_ME@localhost:5432/payodi_db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=payodi
MINIO_SECRET_KEY=CHANGE_ME
# Phase 8 — Coast Guard Alert dispatch
#
# PHASE8_DRY_RUN=true   → SMS is composed and logged, but never sent.
#                         Use this for rehearsal and demos without a key.
# PHASE8_DRY_RUN=false  → SMS is POSTed to Fast2SMS (requires API key).
#
# Flip to false only on stage, after setting FAST2SMS_API_KEY below.

PHASE8_DRY_RUN=true

# Set this only when PHASE8_DRY_RUN=false.
# Sign up at https://www.fast2sms.com/ to get a key.
FAST2SMS_API_KEY=